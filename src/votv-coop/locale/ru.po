#, c-format
msgid "%.0f cm"
msgstr "%.0f см"

#, c-format
msgid "%1$.1f / %2$.1f MB"
msgstr "%1$.1f / %2$.1f МБ"

#, c-format
msgid "%1$s (%2$llu KB)"
msgstr "%1$s (%2$llu КБ)"

#, c-format
msgid "%1$s (last %2$llu KB of %3$llu KB)"
msgstr "%1$s (последние %2$llu КБ из %3$llu КБ)"

#, c-format
msgid "%1$s -- UPDATE AVAILABLE: %2$s"
msgstr "%1$s -- ДОСТУПНО ОБНОВЛЕНИЕ: %2$s"

#, c-format
msgid "%1$s -- a build for your game: %2$s"
msgstr "%1$s -- сборка для вашей игры: %2$s"

#, c-format
msgid "%1$s -- left out: %2$s"
msgstr "%1$s -- исключено: %2$s"

#, c-format
msgid "%1$s -- newest: %2$s, for VOTV %3$s"
msgstr "%1$s -- новейшая: %2$s, для VOTV %3$s"

#, c-format
msgid "%1$s = '%2$s' (%3$s) -- %4$s; not in use, %5$s overrides it."
msgstr "%1$s = '%2$s' (%3$s) -- %4$s; не используется, его переопределяет %5$s."

#, c-format
msgid "%1$s = '%2$s' (%3$s) -- %4$s; nothing it governs starts until it is fixed."
msgstr "%1$s = '%2$s' (%3$s) -- %4$s; ничего из того, чем оно управляет, не запустится, пока это не исправят."

#, c-format
msgid "%1$s = '%2$s' (%3$s) -- %4$s; the built-in default is used."
msgstr "%1$s = '%2$s' (%3$s) -- %4$s; используется значение по умолчанию."

#, c-format
msgid "%1$s = '%2$s' -- not a known setting (typo, or a retired key)."
msgstr "%1$s = '%2$s' -- неизвестная настройка (опечатка или устаревший ключ)."

#, c-format
msgid "%1$s appears %2$llu time with different values; the FIRST line (line %3$d) wins. Pick which one to keep:"
msgid_plural "%1$s appears %2$llu times with different values; the FIRST line (line %3$d) wins. Pick which one to keep:"
msgstr[0] "%1$s встречается %2$llu раз с разными значениями; побеждает ПЕРВАЯ строка (строка %3$d). Выберите, какую оставить:"
msgstr[1] "%1$s встречается %2$llu раза с разными значениями; побеждает ПЕРВАЯ строка (строка %3$d). Выберите, какую оставить:"
msgstr[2] "%1$s встречается %2$llu раз с разными значениями; побеждает ПЕРВАЯ строка (строка %3$d). Выберите, какую оставить:"

#, c-format
msgid "%1$s caught signal '%2$s'"
msgstr "%1$s: получен сигнал '%2$s'"

#, c-format
msgid "%1$s changed skin to %2$s"
msgstr "%1$s: новый скин -- %2$s"

#, c-format
msgid "%1$s could not order: an item was not in the host's store"
msgstr "%1$s: заказ не выполнен -- товара нет в магазине хоста"

#, c-format
msgid "%1$s could not order: the delivery could not be placed"
msgstr "%1$s: заказ не выполнен -- не удалось разместить доставку"

#, c-format
msgid "%1$s could not order: the host could not read its store"
msgstr "%1$s: заказ не выполнен -- хост не смог прочитать свой магазин"

#, c-format
msgid "%1$s could not order: the host refused it"
msgstr "%1$s: заказ не выполнен -- хост отклонил его"

#, c-format
msgid "%1$s could not order: there were not enough credits"
msgstr "%1$s: заказ не выполнен -- не хватает кредитов"

#, c-format
msgid "%1$s could not order: too many items in one order"
msgstr "%1$s: заказ не выполнен -- слишком много предметов в одном заказе"

#, c-format
msgid "%1$s could not place that: the host refused it; pick it up to retry"
msgstr "%1$s: не удалось поставить предмет -- хост отказал; подберите его и повторите"

#, c-format
msgid "%1$s could not sell that"
msgstr "%1$s: продать не удалось"

#, c-format
msgid "%1$s could not sell that: it was already sold"
msgstr "%1$s: продать не удалось -- уже продано"

#, c-format
msgid "%1$s could not sell that: no coin gun exists in the host's world"
msgstr "%1$s: продать не удалось -- в мире хоста нет монетной пушки"

#, c-format
msgid "%1$s could not sell that: the host does not have it"
msgstr "%1$s: продать не удалось -- у хоста его нет"

#, c-format
msgid "%1$s could not sell that: the host does not see you next to it"
msgstr "%1$s: продать не удалось -- хост не видит вас рядом с ним"

#, c-format
msgid "%1$s could not sell that: the host hit an internal error"
msgstr "%1$s: продать не удалось -- у хоста внутренняя ошибка"

#, c-format
msgid "%1$s could not sell that: the host's store will not take it"
msgstr "%1$s: продать не удалось -- магазин хоста его не принимает"

#, c-format
msgid "%1$s deleted an email: %2$s"
msgstr "%1$s: удалено письмо %2$s"

#, c-format
msgid "%1$s is asleep"
msgstr "%1$s спит"

#, c-format
msgid "%1$s is connecting to the game..."
msgstr "%1$s подключается к игре..."

#, c-format
msgid "%1$s is using %2$s"
msgstr "%1$s использует %2$s"

#, c-format
msgid "%1$s joined the game"
msgstr "%1$s присоединился к игре"

#, c-format
msgid "%1$s left the game"
msgstr "%1$s покинул игру"

#, c-format
msgid "%1$s sold it for %2$lld point (the host's price)"
msgid_plural "%1$s sold it for %2$lld points (the host's price)"
msgstr[0] "%1$s: продано за %2$lld очко (цена хоста)"
msgstr[1] "%1$s: продано за %2$lld очка (цена хоста)"
msgstr[2] "%1$s: продано за %2$lld очков (цена хоста)"

#, c-format
msgid "%1$s was turned away: Game version mismatch: server plays VOTV %2$s, client has VOTV %3$s. [%4$s]"
msgstr "%1$s отклонён: версии игры не совпадают -- у сервера VOTV %2$s, у клиента VOTV %3$s. [%4$s]"

#, c-format
msgid "%1$s was turned away: malformed join (version field missing) [%2$s]"
msgstr "%1$s отклонён: некорректный запрос на вход (нет поля версии) [%2$s]"

#, c-format
msgid "%1$s was turned away: official build %2$s [%3$s]"
msgstr "%1$s отклонён: официальная сборка %2$s [%3$s]"

#, c-format
msgid "%1$s was turned away: unofficial build %2$s [%3$s]"
msgstr "%1$s отклонён: неофициальная сборка %2$s [%3$s]"

#, c-format
msgid "%1$u / %2$u objects"
msgstr "%1$u / %2$u объектов"

#, c-format
msgid "%d LAN"
msgstr "%d LAN"

#, c-format
msgid "%d direct"
msgstr "%d напрямую"

#, c-format
msgid "%d online"
msgstr "%d онлайн"

#, c-format
msgid "%d relayed"
msgstr "%d через релей"

#, c-format
msgid "%llu rule in force differs from the rules saved with this world."
msgid_plural "%llu rules in force differ from the rules saved with this world."
msgstr[0] "%llu действующее правило отличается от правил, сохранённых в этом мире."
msgstr[1] "%llu действующих правила отличаются от правил, сохранённых в этом мире."
msgstr[2] "%llu действующих правил отличаются от правил, сохранённых в этом мире."

#, c-format
msgid "%llu s in this step"
msgstr "%llu с на этом шаге"

#, c-format
msgid "%llu server"
msgid_plural "%llu servers"
msgstr[0] "%llu сервер"
msgstr[1] "%llu сервера"
msgstr[2] "%llu серверов"

#, c-format
msgid "%s (without passwords)"
msgstr "%s (без паролей)"

msgid "(hidden -- friends join by invite/IP)"
msgstr "(скрыт -- друзья входят по приглашению/IP)"

