msgstr "МУЛЬТИПЛЕЕР"

msgid "MULTIVOID SETTINGS CHECK"
msgstr "ПРОВЕРКА НАСТРОЕК MULTIVOID"

msgid "Maximum voice audibility distance in centimeters (4800 = 48 m); 0 = unlimited (a whisper stays local); the host's setting in a session. A value of 1..99 is a near-mute range, the host's to choose."
msgstr "Максимальная дальность слышимости голоса в сантиметрах (4800 = 48 м); 0 = без ограничений (шёпот остаётся локальным); в сессии это настройка хоста. Значение 1..99 -- почти беззвучный радиус, выбор за хостом."

msgid "Menu / panels"
msgstr "Меню / панели"

msgid "Mic"
msgstr "Микр."

msgid "Mic gain"
msgstr "Усиление микрофона"

msgid "Mic muted"
msgstr "Микрофон выключен"

msgid "Microphone"
msgstr "Микрофон"

msgid "Multiplayer may not work: you may not see other players, and some features may be off. Check for a Multivoid update made for your game version."
msgstr "Мультиплеер может не работать: вы можете не видеть других игроков, а часть функций может быть отключена. Проверьте обновление Multivoid для вашей версии игры."

#, c-format
msgid "Multiplayer may not work: you may not see other players, and some features may be off. Look for a Multivoid build made for VOTV %1$s."
msgstr "Мультиплеер может не работать: вы можете не видеть других игроков, а часть функций может быть отключена. Найдите сборку Multivoid для VOTV %1$s."

msgid "Multivoid  -  Change name"
msgstr "Multivoid  -  Смена имени"

msgid "Multivoid  -  Direct connect"
msgstr "Multivoid  -  Прямое подключение"

